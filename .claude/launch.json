{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--directory",
        "apps/web"
      ],
      "port": 4173
    },
    {
      "name": "api",
      "runtimeExecutable": "gradle",
      "runtimeArgs": [
        "-p",
        "services/api",
        "bootRun",
        "-q",
        "--args=--server.port=8080"
      ],
      "port": 8080
    }
  ]
}